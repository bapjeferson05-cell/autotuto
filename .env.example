# Copia pra .env (ou exporta direto) — nenhuma dessas variáveis é obrigatória,
# todas têm default em autotuto/config.py.

# Cérebro do planejador. Em vez de editar isso na mão, roda:
#     python -m autotuto.chaves
# Opções: ollama (default, local) | claude | groq | gemini | openrouter |
#         github | nvidia | openai  — ver docs/PROVEDORES.md
AUTOTUTO_LLM=claude

# A chave do provedor que você escolheu (só uma é necessária)
ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# NVIDIA_API_KEY=

# Modelo. Vazio = usa o default de cada provedor (ver autotuto/provedores.py).
# Pro ollama, o default é qwen2.5:7b.
AUTOTUTO_MODELO=qwen2.5:7b

# Endpoint próprio (vLLM, LM Studio, llama.cpp): AUTOTUTO_LLM=openai + a base aqui
# AUTOTUTO_BASE_URL=http://localhost:8000/v1

# Modelo de STT (faster-whisper): tiny | base | small
AUTOTUTO_STT=base

# Mic interrompe sozinho durante a fala? "0" (default) = só teclado/texto
# interrompem — é o caminho principal. "1" = liga o mic (precisa de
# echo-cancel no áudio do sistema pra não se auto-interromper com o eco).
AUTOTUTO_BARGE_IN=0
